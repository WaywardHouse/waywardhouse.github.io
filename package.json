{
  "name": "wayward-house",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Wayward House — hub site. Static Astro build on GitHub Pages; /api/* is a small Cloudflare Worker (worker/).",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/generate-og.mjs && node scripts/assemble-site.mjs && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "api:dev": "wrangler dev --config worker/wrangler.toml",
    "api:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.2.1",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/rss": "^4.0.7",
    "@astrojs/sitemap": "^3.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^6.1.9",
    "gray-matter": "^4.0.3",
    "satori": "^0.12.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "pagefind": "^1.1.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.85.0"
  }
}
